{
  "name": "my-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "My Ledger — zero-based envelope budgeting app",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx -y firebase-tools@latest emulators:start --only hosting",
    "deploy:hosting": "npm run build && npx -y firebase-tools@latest deploy --only hosting",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:deploy": "npx -y firebase-tools@latest deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "vitest": "^4.1.10"
  }
}
